{
  "name": "leptumon-launcher",
  "productName": "Leptumon Launcher",
  "version": "1.0.4",
  "description": "The official launcher for the Leptumon Minecraft server.",
  "main": ".webpack/main",
  "scripts": {
    "prepackage": "node scripts/check-node-version.js",
    "start": "electron-forge start",
    "package": "electron-forge package",
