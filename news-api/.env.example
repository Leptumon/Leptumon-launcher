# Required. Long random secret used to sign in to the admin page.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# or, without Node:
#   openssl rand -base64 32
NEWS_ADMIN_TOKEN=

# Only for `docker compose --profile https`: the (sub)domain that points at this
# server, without https://. Caddy gets its certificate automatically.
#   Example: actus.leptunia.fr
DOMAIN=

# Public address of this service as players reach it, without a trailing slash.
# Used to build links to uploaded images. Optional when the server is on its own
# (sub)domain; needed when it is served under a path. Examples:
#   https://actus.leptunia.fr
#   https://leptunia.fr/news
PUBLIC_URL=

# Behind a reverse proxy (nginx, Caddy, the normal setup) keep this at 1 so
# https and visitor addresses are detected correctly. Docker sets it to 1 itself.
TRUST_PROXY=1

# Largest image upload, in megabytes.
MAX_IMAGE_MB=5

# Without Docker only: where to listen and where to store news.json and images.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
